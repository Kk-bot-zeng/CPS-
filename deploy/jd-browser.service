[Unit]
Description=Isolated interactive JD Chromium browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zlq
WorkingDirectory=/srv/cps-data/jd-collector
Environment=STORE_ID=store1
Environment=DISPLAY=:99
Environment=VNC_PORT=5901
Environment=NOVNC_PORT=6080
Environment=DEBUG_PORT=9222
Environment=LANG=zh_CN.UTF-8
Environment=LC_ALL=zh_CN.UTF-8
ExecStart=/srv/cps-data/jd-collector/jd-browser.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
