# 必填：本地 PostgreSQL 与登录会话
DATABASE_URL=postgresql://cps_dev:change_me@127.0.0.1:5432/cps_dev
SESSION_SECRET=replace_with_a_random_string_at_least_32_characters

# 可选：仅在使用 Supabase 部署方式时填写
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：地图中心；未配置时地图功能不可用
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# 可选：京东采集控制服务；不调试真实同步时保持空值
JD_COLLECTOR_URL=http://127.0.0.1:3210
JD_COLLECTOR_TOKEN=

# 可选：B站操盘看板 AI 分析
DEEPSEEK_API_KEY=

# 可选：销售文案智能体（兼容 OpenAI Chat Completions 接口）
# 未单独填写 API Key 时会复用上面的 DEEPSEEK_API_KEY
COPYWRITING_AI_API_KEY=
COPYWRITING_AI_BASE_URL=https://api.deepseek.com
COPYWRITING_AI_MODEL=deepseek-chat
